<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The single source of the version. The exe reports it at /health by
         reading its own assembly, and build.ps1 passes it to makensis for the
         "Installed apps" entry, so a till's reported version and its
         registered version cannot drift. CI overrides it per build. -->
    <Version>1.0.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>shelivo-print-agent</AssemblyName>
    <RootNamespace>ShelivoPrintAgent</RootNamespace>
    <!-- Embeds the icon in the exe itself. Without it the exe carries no icon
         resource at all, so the DisplayIcon the installer registers (which
         points at this exe) resolves to nothing and "Installed apps" shows a
         blank tile, and the exe looks unbranded in Explorer and Task
         Manager too. -->
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <UseWindowsForms>false</UseWindowsForms>
    <DebugType>none</DebugType>
    <!-- Already constrained to win-x64 via RuntimeIdentifier above, so the
         Windows-only APIs this project calls (PrinterSettings, P/Invoke into
         winspool.drv/gdi32.dll) are never reached on another OS. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
